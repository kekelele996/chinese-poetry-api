# Server port
PORT=1279 # The fall of the Song Dynasty

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# GraphQL query limits (enforced before resolvers run)
GRAPHQL_COMPLEXITY_LIMIT=5000
GRAPHQL_MAX_DEPTH=10
GRAPHQL_MAX_ALIASES=5
GRAPHQL_MAX_NODE_COUNT=2000
GRAPHQL_MAX_BODY_BYTES=1048576
