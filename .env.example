# Server port
PORT=1279 # The fall of the Song Dynasty

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# Graceful shutdown (Go duration strings)
# Drain delay: wait for the load balancer to remove the instance before closing the listener
DRAIN_DELAY=5s
# Shutdown timeout: max wait for in-flight requests before force-closing
SHUTDOWN_TIMEOUT=20s
